# Agentes: por defecto usan el CLI de Claude Code con tu suscripcion (Max/Pro),
# sin API key. Si prefieres la API de Anthropic, pon la key y el backend cambia solo.
# ATLAS_LLM_BACKEND=cli|api  CLAUDE_BIN=/ruta/absoluta/a/claude (si no esta en PATH)
ANTHROPIC_API_KEY=
# Embeddings para dedup semantica (opcional; sin key el pipeline funciona igual)
VOYAGE_API_KEY=

# Infraestructura local (valores por defecto del docker-compose)
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379/0

# Conectores (se completan al configurar cada fuente)
MS_CLIENT_ID=
MS_TENANT_ID=common
HUBSPOT_TOKEN=
GITHUB_TOKEN=

# Operacion
SYNC_INTERVAL_MINUTES=60
TOKEN_BUDGET_INPUT_DAILY=500000
TOKEN_BUDGET_OUTPUT_DAILY=80000
QUIET_HOURS=22:00-06:30
